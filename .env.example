# Plantilla de variables de entorno para riesgo-api-v0.
#
# Uso:
#   1. Copiar este archivo como .env  (cp .env.example .env)
#   2. Rellenar con valores reales del entorno.
#   3. Arrancar el servicio con:  uvicorn main:app --env-file .env ...
#
# .env está en .gitignore y NO se sube al repositorio.

RIESGO_API_KEY=
RIESGO_CLAVE_FIRMA=
RIESGO_UMBRAL_ALTO=0.7
